{
  "name": "sessionsai",
  "displayName": "SessionsAI — Claude Code, Copilot, & VS Code Chat Manager",
  "description": "Browse, search, read and resume your Claude Code, GitHub Copilot CLI and VS Code Chat sessions from the VS Code sidebar.",
  "version": "0.4.0",
  "publisher": "rellik92j",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rellik92j/claude-sessions-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSessions",
          "title": "SessionsAI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeSessions": [
        {
          "type": "webview",
          "id": "claudeSessions.list",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeSessions.refresh",
        "title": "Refresh",
        "category": "SessionsAI",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeSessions.search",
        "title": "Search Sessions…",
        "category": "SessionsAI",
        "icon": "$(search)"
      },
      {
        "command": "claudeSessions.groupByProject",
        "title": "Group by Project",
        "category": "SessionsAI",
        "icon": "$(folder)"
      },
      {
        "command": "claudeSessions.groupByDate",
        "title": "Group by Date",
        "category": "SessionsAI",
        "icon": "$(calendar)"
      },
      {
        "command": "claudeSessions.showCurrentWorkspaceOnly",
        "title": "Show Only Current Workspace",
        "category": "SessionsAI",
        "icon": "$(filter)"
      },
      {
        "command": "claudeSessions.showAll",
        "title": "Show All Projects",
        "category": "SessionsAI",
        "icon": "$(filter-filled)"
      },
      {
        "command": "claudeSessions.resume",
        "title": "Resume Session",
        "category": "SessionsAI",
        "icon": "$(play)"
      },
      {
        "command": "claudeSessions.continueInNewSession",
        "title": "Continue in New Session",
        "category": "SessionsAI",
        "icon": "$(arrow-circle-right)"
      },
      {
        "command": "claudeSessions.continueInNewSessionWithModel",
        "title": "Continue in New Session with Tool or Model…",
        "category": "SessionsAI"
      },
      {
        "command": "claudeSessions.openInClaudeCode",
        "title": "Open in Claude Code Chat",
        "category": "SessionsAI",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claudeSessions.openTranscript",
        "title": "Open Transcript",
        "category": "SessionsAI",
        "icon": "$(book)"
      },
      {
        "command": "claudeSessions.openTranscriptInNewTab",
        "title": "Open Transcript in New Tab",
        "category": "SessionsAI",
        "icon": "$(pinned)"
      },
      {
        "command": "claudeSessions.openRawFile",
        "title": "Open Raw Log",
        "category": "SessionsAI"
      },
      {
        "command": "claudeSessions.copyId",
        "title": "Copy Session ID",
        "category": "SessionsAI"
      },
      {
        "command": "claudeSessions.copyResumeCommand",
        "title": "Copy Resume Command",
        "category": "SessionsAI"
      },
      {
        "command": "claudeSessions.openPr",
        "title": "Open Pull Request",
        "category": "SessionsAI",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "claudeSessions.revealFolder",
        "title": "Open Project Folder in New Window",
        "category": "SessionsAI"
      },
      {
        "command": "claudeSessions.focusSearch",
        "title": "Focus Session Search",
        "category": "SessionsAI",
        "icon": "$(search)"
      },
      {
        "command": "claudeSessions.searchForFile",
        "title": "Search Sessions for This File",
        "category": "SessionsAI",
        "icon": "$(search)"
      },
      {
        "command": "claudeSessions.openOverview",
        "title": "Open Overview",
        "category": "SessionsAI",
        "icon": "$(dashboard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeSessions.openOverview",
          "when": "view == claudeSessions.list",
          "group": "navigation@0"
        },
        {
          "command": "claudeSessions.focusSearch",
          "when": "view == claudeSessions.list",
          "group": "navigation@1"
        },
        {
          "command": "claudeSessions.refresh",
          "when": "view == claudeSessions.list",
          "group": "navigation@2"
        },
        {
          "command": "claudeSessions.groupByProject",
          "when": "view == claudeSessions.list",
          "group": "1_group@1"
        },
        {
          "command": "claudeSessions.groupByDate",
          "when": "view == claudeSessions.list",
          "group": "1_group@2"
        },
        {
          "command": "claudeSessions.showCurrentWorkspaceOnly",
          "when": "view == claudeSessions.list",
          "group": "2_filter@1"
        },
        {
          "command": "claudeSessions.showAll",
          "when": "view == claudeSessions.list",
          "group": "2_filter@2"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeSessions.resume",
          "when": "false"
        },
        {
          "command": "claudeSessions.continueInNewSession",
          "when": "false"
        },
        {
          "command": "claudeSessions.continueInNewSessionWithModel",
          "when": "false"
        },
        {
          "command": "claudeSessions.openTranscript",
          "when": "false"
        },
        {
          "command": "claudeSessions.openTranscriptInNewTab",
          "when": "false"
        },
        {
          "command": "claudeSessions.openRawFile",
          "when": "false"
        },
        {
          "command": "claudeSessions.copyId",
          "when": "false"
        },
        {
          "command": "claudeSessions.copyResumeCommand",
          "when": "false"
        },
        {
          "command": "claudeSessions.openPr",
          "when": "false"
        },
        {
          "command": "claudeSessions.revealFolder",
          "when": "false"
        },
        {
          "command": "claudeSessions.openInClaudeCode",
          "when": "false"
        },
        {
          "command": "claudeSessions.searchForFile",
          "when": "resourceFilename"
        }
      ],
      "webview/context": [
        {
          "command": "claudeSessions.resume",
          "when": "webviewId == 'claudeSessions.list' && webviewSection == 'session'",
          "group": "1_main@1"
        },
        {
          "command": "claudeSessions.continueInNewSession",
          "when": "webviewId == 'claudeSessions.list' && webviewSection == 'session'",
          "group": "1_main@2"
        },
        {
          "command": "claudeSessions.continueInNewSessionWithModel",
          "when": "webviewId == 'claudeSessions.list' && webviewSection == 'session'",
          "group": "1_main@3"
        },
        {
          "command": "claudeSessions.openInClaudeCode",
          "when": "webviewId == 'claudeSessions.list' && webviewSection == 'session' && sessionSource == 'claude' && claudeSessions.hasClaudeCode",
          "group": "1_main@4"
        },
        {
          "command": "claudeSessions.openTranscript",
          "when": "webviewId == 'claudeSessions.list' && webviewSection == 'session'",
          "group": "1_main@5"
        },
        {
          "command": "claudeSessions.openTranscriptInNewTab",
          "when": "webviewId == 'claudeSessions.list' && webviewSection == 'session'",
          "group": "1_main@6"
        },
        {
          "command": "claudeSessions.openPr",
          "when": "webviewId == 'claudeSessions.list' && webviewSection == 'session' && sessionHasPr",
          "group": "1_main@7"
        },
        {
          "command": "claudeSessions.openRawFile",
          "when": "webviewId == 'claudeSessions.list' && webviewSection == 'session'",
          "group": "2_other@1"
        },
        {
          "command": "claudeSessions.copyId",
          "when": "webviewId == 'claudeSessions.list' && webviewSection == 'session'",
          "group": "3_copy@1"
        },
        {
          "command": "claudeSessions.copyResumeCommand",
          "when": "webviewId == 'claudeSessions.list' && webviewSection == 'session' && sessionSource != 'vscode-chat'",
          "group": "3_copy@2"
        },
        {
          "command": "claudeSessions.revealFolder",
          "when": "webviewId == 'claudeSessions.list' && webviewSection == 'project'",
          "group": "1_main@1"
        }
      ],
      "explorer/context": [
        {
          "command": "claudeSessions.searchForFile",
          "when": "!explorerResourceIsFolder",
          "group": "7_claudeSessions"
        }
      ],
      "editor/title/context": [
        {
          "command": "claudeSessions.searchForFile",
          "when": "resourceFilename",
          "group": "7_claudeSessions"
        }
      ]
    },
    "configuration": {
      "title": "SessionsAI",
      "properties": {
        "claudeSessions.projectsDir": {
          "type": "string",
          "default": "",
          "description": "Folder containing Claude Code session logs. Empty = $CLAUDE_CONFIG_DIR/projects or ~/.claude/projects."
        },
        "claudeSessions.sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "copilot-cli",
              "vscode-chat"
            ],
            "enumDescriptions": [
              "Claude Code",
              "GitHub Copilot CLI",
              "VS Code Chat (GitHub Copilot Chat)"
            ]
          },
          "uniqueItems": true,
          "default": [
            "claude",
            "copilot-cli",
            "vscode-chat"
          ],
          "description": "Whose sessions the sidebar shows when a window opens. The chips above the list change this for the current window only."
        },
        "claudeSessions.copilotDir": {
          "type": "string",
          "default": "",
          "description": "GitHub Copilot CLI's folder, with sessions in its session-state folder. Empty = $COPILOT_HOME or ~/.copilot."
        },
        "claudeSessions.vscodeUserDir": {
          "type": "string",
          "default": "",
          "description": "VS Code's user data folder, whose workspaceStorage holds the chat sessions. Empty = the default folders of VS Code and VS Code Insiders."
        },
        "claudeSessions.copilotCommand": {
          "type": "string",
          "default": "copilot",
          "description": "Command used to launch GitHub Copilot CLI when resuming a session."
        },
        "claudeSessions.groupBy": {
          "type": "string",
          "enum": [
            "project",
            "date"
          ],
          "default": "project",
          "description": "How sessions are grouped in the sidebar."
        },
        "claudeSessions.currentWorkspaceOnly": {
          "type": "boolean",
          "default": false,
          "description": "Only show sessions started inside the currently open workspace folders."
        },
        "claudeSessions.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Command used to launch Claude Code when resuming a session."
        },
        "claudeSessions.terminalLocation": {
          "type": "string",
          "enum": [
            "editor",
            "panel"
          ],
          "enumDescriptions": [
            "Open as a tab in the editor area, like Claude Code: Open in Terminal",
            "Open in the bottom terminal panel"
          ],
          "default": "editor",
          "description": "Where Resume opens the Claude Code CLI terminal."
        },
        "claudeSessions.showThinking": {
          "type": "boolean",
          "default": false,
          "description": "Include Claude's thinking blocks in the transcript view."
        },
        "claudeSessions.reuseTranscriptTab": {
          "type": "boolean",
          "default": true,
          "description": "Open transcripts in one shared preview tab that the next transcript replaces, like VS Code preview editors. Double-click a session, or use Keep open, to give it its own tab. When off, every transcript gets its own tab."
        },
        "claudeSessions.hideEmptySessions": {
          "type": "boolean",
          "default": true,
          "description": "Hide sessions that contain no prompts or replies."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && npm run bundle && node --test test/*.test.js",
    "package": "npm run compile && npm run bundle && vsce package --allow-missing-repository",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --sourcemap --outfile=dist/extension.js",
    "vscode:prepublish": "npm run bundle"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2"
  }
}
